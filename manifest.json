{
  "manifest_version": 3,
  "name": "ChatGPT Speech Saver",
  "description": "Download ChatGPT Read aloud audio from the first synthesis request or cached audio blobs.",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "ChatGPT Speech Saver", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
